# =====================================================================
# PalaySense environment template
# Copy to `.env` (or Streamlit Secrets) and fill in your real values.
# NEVER commit the real `.env` or `.streamlit/secrets.toml`.
# =====================================================================

# Firebase Web API Key (Project Settings > General > Web API Key)
FIREBASE_WEB_API_KEY=REPLACE_WITH_WEB_API_KEY

# Firebase Storage Bucket (Storage > Files tab)
FIREBASE_STORAGE_BUCKET=palaysense.firebasestorage.app

# Firebase Project ID
FIREBASE_PROJECT_ID=palaysense
